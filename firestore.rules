rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global rule: Allow full read and write for development and admin control
    match /{document=**} {
      allow read, write: if true;
    }

    // Specific Collection Rules
    match /site_settings/{docId} {
      allow read, write: if true;
    }

    match /services/{docId} {
      allow read, write: if true;
    }

    match /projects/{docId} {
      allow read, write: if true;
    }

    match /gallery/{docId} {
      allow read, write: if true;
    }

    match /blogs/{docId} {
      allow read, write: if true;
    }

    match /contacts/{docId} {
      allow read, write: if true;
    }
  }
}
